<?xml version="1.0"?>
<!-- webots_ros2_driver description of the Webots WCR prototype: sensor topics (same names as the dam
     sim, so its nodes and Foxglove layout are reused) + the ProtoDriver plugin (thrust, skid steer,
     odometry). Frame names match resource/wcr_proto.urdf. -->
<robot name="wcr">
  <webots>
    <device reference="lidar" type="Lidar">
      <ros>
        <topicName>/scan</topicName>
        <frameName>lidar_link</frameName>
        <updateRate>10</updateRate>
        <alwaysOn>true</alwaysOn>
      </ros>
    </device>
    <device reference="wall_camera" type="Camera">
      <ros>
        <topicName>/wall_camera</topicName>
        <frameName>wall_camera_optical</frameName>
        <updateRate>15</updateRate>
        <alwaysOn>true</alwaysOn>
      </ros>
    </device>
    <device reference="front_camera" type="Camera">
      <ros>
        <topicName>/front_camera</topicName>
        <frameName>front_camera_optical</frameName>
        <updateRate>15</updateRate>
        <alwaysOn>true</alwaysOn>
      </ros>
    </device>
    <plugin type="webots_ros2_driver::Ros2IMU">
      <enabled>true</enabled>
      <topicName>/imu</topicName>
      <alwaysOn>true</alwaysOn>
      <frameName>imu_link</frameName>
      <inertialUnitName>imu</inertialUnitName>
      <gyroName>gyro</gyroName>
      <accelerometerName>accelerometer</accelerometerName>
      <updateRate>100</updateRate>
    </plugin>
    <plugin type="wcr_proto.proto_driver.ProtoDriver">
      <publishPeriodMs>20</publishPeriodMs>
    </plugin>
  </webots>
</robot>
